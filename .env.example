BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
LOG_LEVEL=INFO

# Free operation is the default, even if an old API key is present.
OPENAI_ENABLED=false
NEWS_SOURCE=rss
MARKET_SOURCE=reference

# Legacy paid features require explicit OPENAI_ENABLED=true.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL is required for automatic reports and paper review history.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Admin panel is served only when PANEL_PASSWORD is set.
PANEL_USERNAME=admin
PANEL_PASSWORD=
PANEL_SECRET_KEY=
PANEL_SECURE_COOKIE=
PORT=8080

# Optional Windows MT5 analysis and native manual-ticket bridge.
MARKET_GOLD_SYMBOL=XAUUSD
MARKET_BRIDGE_KEY=
# Retired automatic path: keep false for the M15/M5/M1 manual workflow.
MT5_TRADING_ENABLED=false
# Manual mode prepares a visible laptop ticket; the human clicks Buy/Sell.
# Actions expire after M1 close: qualified=10s, experimental_demo=30s.
# Wait for a fresh signal; TP1 success horizon is 60min from actual entry.
# Manual mode takes priority over automatic trading. Use a distinct private key.
MT5_MANUAL_TICKETS_ENABLED=false
MT5_MANUAL_BRIDGE_KEY=

# Explicit Demo research opt-in; default qualified still requires pinned evidence.
# experimental_demo publishes labelled unproven Demo0.01 proposals, never orders.
# It uses a 30s entry window and a pullback in 3 preceding closed M5 candles.
# Estimated commission floor: loss cash/unit * max(spread,10*tick_size).
# Estimated per-side slippage floor: max(spread/2,2*tick_size).
# Reported costs above these floors are retained; estimates are never verified.
MT5_SIGNAL_MODE=qualified

# Server-local empirical artifact for qualified mode. Empty blocks qualified proposals.
# Require the exact broker/specs/strategy and >=200 independent OOS trades,
# with lower endpoint of the two-sided 95% Wilson interval >=70% after costs.
# Nonoverlap alone is insufficient: verified effective independent N = raw OOS N.
# Historical specs, costs and UTC/timezone/DST evidence must cover all history.
# No feed-provided certificate or AI confidence may replace this artifact.
MT5_EVIDENCE_PATH=
MT5_EVIDENCE_SHA256=

# Windows helper only: verify current terminal time normalization before use.
# Historical broker/DST offsets must be documented separately by period.
MT5_BROKER_UTC_OFFSET_MINUTES=

# Windows helper only: unknown costs block qualified proposals.
# experimental_demo uses the explicitly labelled server estimates above.
# True requires explicit operator verification, matching the reviewed artifact.
MT5_COST_MODEL_VERIFIED=false
# Round-trip commission in account currency per lot; blank means unknown.
MT5_COMMISSION_ROUND_TURN_PER_LOT=
# Conservative slippage allowance in price units per side; blank means unknown.
MT5_SLIPPAGE_PRICE=
